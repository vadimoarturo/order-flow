{
  "name": "@orderflow/api",
  "private": true,
  "scripts": {
    "build": "prisma generate --schema prisma/schema.prisma && nest build",
    "typecheck": "tsc --noEmit",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "worker": "APP_ROLE=worker node dist/main.js",
    "migrate": "prisma migrate deploy --schema prisma/schema.prisma && tsx prisma/seed.ts",
    "integrations": "APP_ROLE=integrations node dist/main.js",
    "hidden": "APP_ROLE=hidden node dist/main.js",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:format": "prisma format --schema prisma/schema.prisma",
    "migrate:resolve": "prisma migrate resolve --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "kafkajs": "2.2.4",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7",
    "@prisma/client": "6.19.3",
    "@nestjs/cqrs": "11.0.3",
    "class-validator": "0.15.1",
    "class-transformer": "0.5.1",
    "@nestjs/swagger": "11.4.8"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "prisma": "6.19.3",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8"
  }
}
